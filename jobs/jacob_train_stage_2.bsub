#!/bin/bash
#BSUB -J iws_h200                          # job name
#BSUB -o jobs/logs/iws_mujoco.%J.out           # stdout log (submit from project root)
#BSUB -e jobs/logs/iws_mujoco.%J.err           # stderr log
#BSUB -n 4                                # CPU cores: 8 workers for data loading
#BSUB -R span[hosts=1]                     # single host
#BSUB -M 32768MB                           # 16 GB system RAM
#BSUB -gpu "num=1"                      # 1× full H200 (143 GB HBM3e)
#BSUB -W 20:00                             # 12-hour runtime limit
#BSUB -q batch_b200                    # H200 MIG queue (no backlog)
#BSUB -P BH-000557-01  	                   # project to charge, AIQ-103
#BSUB -G rb_bd_dlp_rng-dl01_cr_AIQ_employees

## Alternatively
# -q batch_h200_mig                    # H200 MIG queue 
# -gpu "num=1:mig=7"                         # 1× full H200 (143 GB HBM3e)

# ---------------------------------------------------------------------------
# Environment setup
# ---------------------------------------------------------------------------
source /fs/applications/modules/current/init/bash
module unload proxy4server-access
source /fs/applications/p4s-access/1.0/ActivateP4S.sh -a

# module unload cuda
# module load cuda/12.6.0
# module load conda/25.1.1
source ~/miniforge3/etc/profile.d/conda.sh
conda activate iws-5090

export COLUMNS=200

# Sanity-check: verify GPU is visible before starting training
echo "=== GPU diagnostics ==="
nvidia-smi || { echo "ERROR: nvidia-smi failed — GPU not available on this node"; exit 1; }
echo "========================"

# Reduce CUDA memory fragmentation
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True


# ---------------------------------------------------------------------------
# Stage 2  (bf16-mixed + batch_size=128 for H200 utilization)
# ---------------------------------------------------------------------------
cd ~/interactive_world_sim
# conda activate iws

FILE_DIR="/fs/scratch/rb_bd_dlp_rng-dl01_cr_AIQ_employees/aiq103/iws"

python main.py +name=robosuite_lift_stage_2_jacob_b200 algorithm=latent_world_model \
  experiment=exp_latent_dyn dataset=sim_robosuite_dataset \
  dataset.dataset_dir=${FILE_DIR}/data/robosuite/lift \
  dataset.horizon=10 dataset.val_horizon=150 \
  experiment.training.batch_size=4 \
  experiment.training.max_steps=1000005 \
  experiment.training.log_every_n_steps=100 \
  experiment.validation.limit_batch=1.0 \
  experiment.validation.batch_size=4 \
  experiment.validation.val_every_n_step=10000 \
  experiment.training.checkpointing.every_n_train_steps=10000 \
  experiment.training.data.num_workers=4 \
  experiment.validation.data.num_workers=4 \
  algorithm.latent_dim=512 algorithm.action_dim=4 \
  algorithm.noise_scheduler.loss_weighting=uniform \
  algorithm.sampling_strategy=terminal_only \
  algorithm.dyn_infer_steps=3 \
  "algorithm.load_ae='${FILE_DIR}/outputs/robosuite_lift_stage_1_jacob_b200_cam1/2026-05-25/07-03-21/checkpoints/epoch=35-step=150000.ckpt'" \
  algorithm.training_stage=2 \
  hydra.run.dir=${FILE_DIR}/outputs/\${name}/\${now:%Y-%m-%d}/\${now:%H-%M-%S} \
  experiment.training.precision=bf16-mixed \
  experiment.validation.precision=bf16-mixed \
  "dataset.obs_keys=[camera_0_color]" \
  +experiment.training.checkpointing.save_top_k=-1 \
  "load='${FILE_DIR}/outputs/robosuite_lift_stage_2_jacob_b200/2026-05-26/23-24-26/checkpoints/epoch=40-step=680000.ckpt'"

  ## Resume from previous checkpoint 
  #"load='${FILE_DIR}/outputs/robosuite_lift_stage_2/2026-04-21/22-09-12/checkpoints/epoch=2-step=60000.ckpt'"

